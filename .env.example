# =========================
# HairVision AI
# Environment Variables
# =========================

# Application
APP_NAME=HairVision AI
APP_ENV=development
DEBUG=true

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql+psycopg://hairvision:hairvision_dev_password@localhost:5432/hairvision

# Storage
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# AI
MODEL_DIR=models/production